rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Portfolio assets
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Petsitting assets
    // create/update and delete are split on purpose. `allow write` covers all
    // three, and on a delete there is no incoming file, so request.resource is
    // null and the size check fails. That is what made every delete under this
    // prefix impossible, including the petsitting admin's own.
    match /petsitting/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.resource.size < 15 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Legacy root folder, uploaded by hand before either admin existed.
    match /profile/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback: deny everything else
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
